{
  "name": "tonpei-1-in-18000",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "description": "とんぺー1.8万分の１ — 東北大学とは関係のない、学生団体による非公式プロジェクト",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "db:local": "wrangler d1 execute tonpei-18000 --local --file schema.sql",
    "pages:dev": "npm run build && wrangler pages dev --port 8788",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "lint:content": "tsx scripts/lint-content.ts",
    "export:events": "tsx scripts/export-events.ts",
    "facts": "tsx scripts/export-facts.ts",
    "ogp": "tsx scripts/ogp.ts",
    "shots": "tsx scripts/screenshot.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
